          applyRichCommand('clear');
          return;
        }
        const buttonAction = event.target.closest('[data-button-action]')?.dataset.buttonAction;
        if (buttonAction === 'add') {
          normalizeCardButtons(card).push(createCardButton({ text: state.language === 'en' ? 'Learn more' : '了解更多' }));
          renderCardEditor();
          setDirty();
          return;
        }
        if (buttonAction === 'delete') {
          const buttonId = event.target.closest('[data-button-id]')?.dataset.buttonId;
          card.buttons = normalizeCardButtons(card).filter(button => button.id !== buttonId);
          renderCardEditor();
          setDirty();
          return;
