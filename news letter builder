      $('#addCardBtn').addEventListener('click', () => {
        const palette = ['#eef5ff', '#fff4e8', '#eef8f1', '#f4efff'];
        const card = createDefaultCard({ titleBgColor: palette[state.cards.length % palette.length] });
        state.cards.push(card);
        state.selectedId = card.id;
        renderCardList();
        renderCardEditor();
        setDirty();
