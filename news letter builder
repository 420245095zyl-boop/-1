      function rememberRichSelection() {
        const editor = $('[data-rich-editor]', elements.cardEditor);
        const selection = window.getSelection();
        if (!editor || !selection || !selection.rangeCount) return false;
        const range = selection.getRangeAt(0);
        const commonNode = range.commonAncestorContainer.nodeType === 1
          ? range.commonAncestorContainer
          : range.commonAncestorContainer.parentNode;
        if (!commonNode || !editor.contains(commonNode)) return false;
        savedRichRange = range.cloneRange();
        return true;
      }

      function restoreRichSelection() {
        const editor = $('[data-rich-editor]', elements.cardEditor);
        if (!editor || !savedRichRange) return null;
        const commonNode = savedRichRange.commonAncestorContainer.nodeType === 1
          ? savedRichRange.commonAncestorContainer
          : savedRichRange.commonAncestorContainer.parentNode;
        if (!commonNode || !editor.contains(commonNode)) return null;
        const selection = window.getSelection();
        selection.removeAllRanges();
        selection.addRange(savedRichRange);
        editor.focus();
        return savedRichRange;
      }

      function syncRichEditor() {
        const editor = $('[data-rich-editor]', elements.cardEditor);
        const card = selectedCard();
        if (!editor || !card) return;
        card.bodyRichHtml = editor.innerHTML;
        card.body = editor.innerText.replace(/\n{3,}/g, '\n\n').trim();
        setDirty();
      }

      function applyRichCommand(command, value) {
        const editor = $('[data-rich-editor]', elements.cardEditor);
        const range = restoreRichSelection();
        if (!editor || !range || range.collapsed) {
          showToast('请先在正文中选中要设置的文字。', true);
          return;
        }
        document.execCommand('styleWithCSS', false, false);
        if (command === 'fontSize') {
          const size = safeFontSize(value);
          document.execCommand('fontSize', false, '7');
          $$('font[size="7"]', editor).forEach(font => {
            font.style.fontSize = size + 'px';
            font.style.lineHeight = Math.round(size * 1.58) + 'px';
            font.removeAttribute('size');
          });
        } else if (command === 'color') {
          const color = safeColor(value, '#2463D4');
          document.execCommand('foreColor', false, color);
          $$('font[color]', editor).forEach(font => {
            const normalized = normalizeCssColor(font.getAttribute('color')) || color;
            font.style.color = normalized;
            font.removeAttribute('color');
          });
        } else if (command === 'clear') {
          document.execCommand('removeFormat', false, null);
        }
        rememberRichSelection();
        syncRichEditor();
      }

      function moveCard(id, direction) {
        const index = state.cards.findIndex(card => card.id === id);
        const target = index + direction;
        if (index < 0 || target < 0 || target >= state.cards.length) return;
        const [card] = state.cards.splice(index, 1);
        state.cards.splice(target, 0, card);
        renderCardList();
        setDirty();
      }

      function duplicateCard(id) {
        const index = state.cards.findIndex(card => card.id === id);
        if (index < 0) return;
        const copy = JSON.parse(JSON.stringify(state.cards[index]));
        copy.id = makeId();
        copy.buttons = normalizeCardButtons(copy).map(button => ({ ...button, id: makeButtonId() }));
        copy.title = (copy.title || '卡片') + '（副本）';
        state.cards.splice(index + 1, 0, copy);
        state.selectedId = copy.id;
        renderCardList();
        renderCardEditor();
        setDirty();
      }

      function deleteCard(id) {
        if (state.cards.length <= 1) {
          showToast('至少需要保留一张卡片。', true);
          return;
        }
        const card = state.cards.find(item => item.id === id);
        if (!confirm(`确定删除“${card?.title || '这张卡片'}”吗？`)) return;
        const index = state.cards.findIndex(item => item.id === id);
        state.cards.splice(index, 1);
        if (state.selectedId === id) state.selectedId = state.cards[Math.min(index, state.cards.length - 1)].id;
        renderCardList();
        renderCardEditor();
        setDirty();
      }

      elements.tabs.forEach(tab => tab.addEventListener('click', () => {
        elements.tabs.forEach(item => item.classList.toggle('active', item === tab));
        elements.panels.forEach(panel => panel.classList.toggle('active', panel.dataset.panel === tab.dataset.tab));
      }));

      $('#languageInput').addEventListener('change', event => { state.language = event.target.value; setDirty(); });
      $('#monthInput').addEventListener('input', event => { state.month = event.target.value; setDirty(); });
      $('#newsletterTitleInput').addEventListener('input', event => { state.newsletterTitle = event.target.value; setDirty(); });
      $('#newsletterBgColorInput').addEventListener('input', event => {
        state.newsletterBgColor = event.target.value;
        $('#newsletterBgColorText').value = event.target.value;
        setDirty();
      });
      $('#newsletterBgColorText').addEventListener('input', event => {
