          showToast('草稿已保存到当前浏览器。');
        } catch (error) {
          showToast('草稿过大，无法保存到浏览器。请导出 JSON 文件。', true);
        }
      }

      function loadLocal() {
        const saved = localStorage.getItem(STORAGE_KEY);
        if (!saved) { showToast('当前浏览器中没有已保存的草稿。', true); return; }
        try {
          applyImportedState(JSON.parse(saved));
          elements.saveStatus.textContent = '已读取草稿';
          showToast('已读取浏览器草稿。');
        } catch (error) { showToast('草稿数据无法读取。', true); }
      }

      function applyImportedState(data) {
        if (!data || !Array.isArray(data.cards)) throw new Error('无效的草稿');
        const base = defaultState();
        state = { ...base, ...data };
        state.version = 5;
        state.showWelcome = data.showWelcome !== false;
        state.showFeedback = data.showFeedback !== false;
        state.emailWidth = '840';
        state.welcomeHeight = normalizeHeight(state.welcomeHeight);
        state.feedbackHeight = normalizeHeight(state.feedbackHeight);
        state.cards = data.cards.length ? data.cards.map(card => {
          const normalized = { ...createDefaultCard(), ...card, id: card.id || makeId() };
          normalized.height = normalizeHeight(normalized.height);
          normalized.bodyRichHtml = sanitizeRichEditorHtml(card.bodyRichHtml || legacyBodyToRichHtml(card.body));
          normalized.buttons = Array.isArray(card.buttons)
            ? card.buttons.map(button => createCardButton({ ...button, id: button?.id || makeButtonId() }))
            : card.showButton === false
              ? []
              : [createCardButton({ text: card.buttonText || '了解更多', url: card.buttonUrl || '' })];
          return normalized;
        }) : base.cards;
        if (!state.cards.some(card => card.id === state.selectedId)) state.selectedId = state.cards[0].id;
        renderAll();
      }

      $('#saveLocalBtn').addEventListener('click', saveLocal);
      $('#loadLocalBtn').addEventListener('click', loadLocal);
      $('#exportDraftBtn').addEventListener('click', () => {
        downloadBlob(JSON.stringify(state, null, 2), 'application/json;charset=utf-8', fileNameWithExtension(state.fileName + ' draft', '.json'));
        showToast('草稿 JSON 已导出。');
      });
      $('#importDraftBtn').addEventListener('click', () => $('#draftFileInput').click());
      $('#draftFileInput').addEventListener('change', event => {
        const file = event.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onerror = () => showToast('无法读取草稿文件。', true);
        reader.onload = () => {
          try { applyImportedState(JSON.parse(String(reader.result))); showToast('草稿已导入。'); }
          catch (error) { showToast('JSON 草稿格式不正确。', true); }
        };
        reader.readAsText(file, 'utf-8');
        event.target.value = '';
      });

      function downloadHtml() {
        const html = buildEmail();
        const bytes = updateSize(html);
        if (bytes > MAX_HTML_BYTES && !confirm(`当前 HTML 为 ${(bytes / 1024).toFixed(1)} KB，超过 64 KB。仍然导出吗？`)) return;
        downloadBlob(html, 'text/html;charset=utf-8', fileNameWithExtension(state.fileName, '.html'));
        showToast('Newsletter HTML 已导出。');
      }

      $('#downloadHtmlBtn').addEventListener('click', downloadHtml);
      $('#downloadHtmlBtnBottom').addEventListener('click', downloadHtml);
      $('#refreshPreviewBtn').addEventListener('click', () => { renderPreview(); showToast('预览已刷新。'); });

      elements.previewFrame.addEventListener('load', updateHeightReadouts);
      window.addEventListener('resize', resizePreview);
      if (window.ResizeObserver) new ResizeObserver(resizePreview).observe(elements.previewWrap);
      renderAll();
    })();
  </script>
</body>
</html>
