      elements.cardList.addEventListener('click', event => {
        const item = event.target.closest('[data-card-id]');
        if (!item) return;
        const id = item.dataset.cardId;
        const actionButton = event.target.closest('[data-action]');
        const action = actionButton?.dataset.action || 'select';
        if (action === 'select') {
          state.selectedId = id;
          renderCardList();
          renderCardEditor();
        } else if (action === 'up') moveCard(id, -1);
        else if (action === 'down') moveCard(id, 1);
        else if (action === 'duplicate') duplicateCard(id);
        else if (action === 'delete') deleteCard(id);
      });

      elements.cardList.addEventListener('dragstart', event => {
        const item = event.target.closest('[data-card-id]');
        if (!item) return;
        draggedId = item.dataset.cardId;
        item.classList.add('dragging');
        event.dataTransfer.effectAllowed = 'move';
      });
      elements.cardList.addEventListener('dragend', event => {
        event.target.closest('[data-card-id]')?.classList.remove('dragging');
        draggedId = '';
      });
      elements.cardList.addEventListener('dragover', event => { event.preventDefault(); event.dataTransfer.dropEffect = 'move'; });
      elements.cardList.addEventListener('drop', event => {
        event.preventDefault();
        const target = event.target.closest('[data-card-id]');
        if (!target || !draggedId || target.dataset.cardId === draggedId) return;
        const from = state.cards.findIndex(card => card.id === draggedId);
        const to = state.cards.findIndex(card => card.id === target.dataset.cardId);
        const [card] = state.cards.splice(from, 1);
        state.cards.splice(to, 0, card);
        renderCardList();
        setDirty();
      });

      elements.cardEditor.addEventListener('pointerdown', event => {
        if (event.target.closest('[data-rich-toolbar]')) rememberRichSelection();
      });

      elements.cardEditor.addEventListener('mouseup', event => {
        if (event.target.closest('[data-rich-editor]')) rememberRichSelection();
      });

      elements.cardEditor.addEventListener('keyup', event => {
        if (event.target.closest('[data-rich-editor]')) rememberRichSelection();
      });

      elements.cardEditor.addEventListener('paste', event => {
        if (!event.target.closest('[data-rich-editor]')) return;
        event.preventDefault();
        const text = event.clipboardData?.getData('text/plain') || '';
        document.execCommand('insertText', false, text);
      });

      elements.cardEditor.addEventListener('input', event => {
        const card = selectedCard();
        if (!card) return;
        if (event.target.closest('[data-rich-editor]')) {
          syncRichEditor();
          return;
        }
        if (event.target.dataset.richCommand === 'color') {
          applyRichCommand('color', event.target.value);
          return;
        }
        const buttonField = event.target.dataset.buttonField;
        if (buttonField) {
          const button = normalizeCardButtons(card).find(item => item.id === event.target.dataset.buttonId);
          if (!button) return;
          button[buttonField] = event.target.value;
          setDirty();
          return;
        }
        const field = event.target.dataset.cardField;
        if (!field) return;
        if (field === 'titleBgColorText' || field === 'bodyColorText') {
          if (/^#[0-9a-f]{6}$/i.test(event.target.value)) {
            const colorField = field === 'titleBgColorText' ? 'titleBgColor' : 'bodyColor';
            card[colorField] = event.target.value;
            const color = $(`[data-card-field="${colorField}"]`, elements.cardEditor);
            if (color) color.value = event.target.value;
          }
        } else {
          card[field] = event.target.value;
          if (field === 'titleBgColor' || field === 'bodyColor') {
            const textField = field === 'titleBgColor' ? 'titleBgColorText' : 'bodyColorText';
            const text = $(`[data-card-field="${textField}"]`, elements.cardEditor);
