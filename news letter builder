      $('#welcomeBodyInput').addEventListener('input', event => { state.welcomeBody = event.target.value; setDirty(); });
      $('#heroUrlInput').addEventListener('input', event => { state.heroUrl = event.target.value; renderHeroState(); setDirty(); });
      $('#fileNameInput').addEventListener('input', event => { state.fileName = event.target.value; setDirty(); });
